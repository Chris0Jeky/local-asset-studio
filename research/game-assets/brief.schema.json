{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Game Asset Brief v1","type":"object","required":["schema_version","asset_id","route","description","target","constraints","budget"],"properties":{"schema_version":{"const":1},"asset_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,63}$"},"route":{"enum":["reference-image","character-2d-frames","character-2d-cutout","rendered-sprites","prop-3d","character-3d","tiles-materials","vfx-ui-pack"]},"description":{"type":"string","minLength":1,"maxLength":12000},"references":{"type":"array","maxItems":12,"items":{"type":"object","required":["id","role","kind","path","sha256","take","ignore"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,63}$"},"role":{"enum":["identity","style","pose","costume","composition","geometry","motion","mask"]},"kind":{"enum":["image","video","mesh","rig","document"]},"path":{"type":"string","description":"Portable workspace-relative path; runtime additionally rejects traversal and symlink escape."},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"take":{"type":"array","items":{"type":"string","minLength":1}},"ignore":{"type":"array","items":{"type":"string","minLength":1}}}}},"target":{"type":"object","required":["engine","outputs"],"properties":{"engine":{"enum":["godot","unity","unreal","web","generic"]},"outputs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}},"constraints":{"type":"array","items":{"type":"string","minLength":1}},"budget":{"type":"object","required":["generation_attempts","repair_attempts_per_stage","allow_paid_services"],"properties":{"generation_attempts":{"type":"integer","minimum":1,"maximum":256},"repair_attempts_per_stage":{"type":"integer","minimum":0,"maximum":3},"allow_paid_services":{"const":false}}}}}
