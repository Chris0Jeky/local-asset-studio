diff --git a/.github/workflows/guided-journey-browser.yml b/.github/workflows/guided-journey-browser.yml
new file mode 100644
index 0000000..e37daf8
--- /dev/null
+++ b/.github/workflows/guided-journey-browser.yml
@@ -0,0 +1,38 @@
+name: Guided journey browser
+on:
+  pull_request:
+    paths:
+      - 'app/static/**'
+      - 'studio_workflow/guides.py'
+      - 'tests/studio_guide*'
+      - 'tests/studio_browser_smoke.py'
+      - 'tests/test_studio_guide.py'
+      - '.github/workflows/guided-journey-browser.yml'
+permissions:
+  contents: read
+jobs:
+  journeys:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - run: python -m pip install playwright==1.57.0
+      - run: python -m playwright install --with-deps chromium
+      - run: python -m unittest discover -s tests -p test_studio_guide.py -v
+      - name: Actual pages and native HTTP, storage, keyboard and stage navigation
+        run: python tests/studio_guide_browser.py --out .runtime/guide-proof
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: guide-browser-proof
+          path: .runtime/guide-proof/
+          if-no-files-found: ignore
+          retention-days: 7
diff --git a/app/static/studio-guide-state.js b/app/static/studio-guide-state.js
