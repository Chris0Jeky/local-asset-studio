@@ -0,0 +1,29 @@
+/* Pure evidence rules: assertions describe observed prerequisites, not acceptance. */
+const {test}=require('node:test'), assert=require('node:assert/strict');
+const C=require('../app/static/studio-guide-state.js');
+const recipe={id:'image',backend_id:'primary'};
+const ready=()=>({recipe,backend:'primary',health:{online:true,worker_alive:true,schema_available:true,missing_models:{},comfy_url:'http://127.0.0.1:8188'},backend_report:{active:'primary',busy:false,profiles:[{id:'primary',url:'http://127.0.0.1:8188'}]}});
+const state=(check,s)=>C.evaluate(check,s).state;
+test('navigation and unknown checks never report success',()=>{assert.equal(state('manual'),'manual');assert.equal(state('unimplemented'),'unknown');assert.equal(state('recipe'),'blocked');});
+test('recipe selection is not readiness',()=>{assert.equal(state('recipe',{recipe}),'met');assert.equal(state('readiness',{recipe}),'unknown');});
+test('wording requires actual text and never claims suitability',()=>{assert.equal(state('prompt',{recipe}),'blocked');assert.equal(state('prompt',{recipe,prompt_present:true}),'met');});
+test('reference-free recipes cannot satisfy reference intent',()=>{assert.equal(state('reference_recipe',{recipe,references:{supported:false}}),'blocked');});
+test('source selection, missing source and pending validation stay distinct',()=>{for(const [r,expected] of [[{selected:true},'unknown'],[{attached:false},'blocked'],[{attached:true,pending:true},'unknown'],[{attached:true,missing:true},'blocked'],[{attached:true,mask:true},'unknown'],[{attached:true},'met']])assert.equal(state('references',{recipe,references:{supported:true,...r}}),expected);});
+test('readiness requires all explicit signals',()=>{for(const field of ['online','worker_alive','schema_available','missing_models']){const s=ready();delete s.health[field];assert.equal(state('readiness',s),'unknown');}assert.equal(state('readiness',ready()),'met');});
+test('backend mismatch or changing endpoint is not a ready recipe',()=>{const s=ready();s.backend_report.active='other';assert.equal(state('readiness',s),'unknown');s.backend_report.active='primary';s.health.comfy_url='http://127.0.0.1:8192';assert.equal(state('readiness',s),'unknown');});
+test('known unavailable runtime or dependencies are blocked',()=>{for(const patch of [{online:false},{worker_alive:false},{missing_models:{image:['model.safetensors']}}])assert.equal(state('readiness',{...ready(),health:{...ready().health,...patch}}),'blocked');assert.equal(state('readiness',{...ready(),switching:true}),'blocked');});
+test('foreign recipe environment stays blocked',()=>assert.equal(state('readiness',{...ready(),recipe:{id:'other',backend_id:'h3'}}),'blocked'));
+test('static graph success is tied to current schema and explicit result',()=>{assert.equal(state('graph_check',{}),'blocked');for(const valid of [null,false])assert.equal(state('graph_check',{authoring:{document_present:true,schema_matches:true,checked_valid:valid}}),'blocked');assert.equal(state('graph_check',{authoring:{document_present:true,schema_matches:true,checked_valid:true}}),'met');});
+test('saved state cannot conceal dirty edits, pending saves or conflict',()=>{for(const [patch,expected] of [[{},'met'],[{dirty:true},'blocked'],[{blocked:true},'unknown'],[{conflict:true},'unknown']])assert.equal(state('saved',{project:{id:'doc',revision:3,dirty:false,...patch}}),expected);});
+test('assets must actually be selected',()=>{assert.equal(state('selection',{selection:0}),'blocked');assert.equal(state('selection',{selection:2}),'met');});
+const run=()=>({job_id:'chosen',job:{id:'chosen',status:'completed',outputs:[{asset_id:'a'}]},assets:[{id:'a',job_id:'chosen',review:'unreviewed'}]});
+test('run selection is explicit rather than latest-job inference',()=>{const s=run();delete s.job_id;assert.equal(state('output',s),'unknown');s.job_id='different';assert.equal(state('output',s),'unknown');});
+test('uncertain and active runs retain identity without retry encouragement',()=>{for(const status of ['uncertain','submitting','queued','waiting','running']){const s=run();s.job.status=status;assert.equal(state('output',s),'unknown');}});
+test('completed engine without outputs is not output evidence',()=>{const s=run();s.job.outputs=[];assert.equal(state('output',s),'blocked');});
+test('partial output evidence does not require pretending engine success',()=>{const s=run();s.job.status='partial';assert.equal(state('output',s),'met');assert.match(C.evaluate('output',s).message,/partial/);});
+test('review requires unique source-matched asset records',()=>{for(const assets of [null,[],[{id:'a',job_id:'wrong',review:'selected'}],[{id:'a',job_id:'chosen',review:'selected'},{id:'a',job_id:'chosen',review:'selected'}]])assert.equal(state('review',{...run(),assets}),'unknown');});
+test('review records decisions without converting rejected art into accepted art',()=>{assert.equal(state('review',run()),'blocked');for(const review of ['selected','rejected','needs_work']){const s=run();s.assets[0].review=review;assert.equal(state('review',s),'met');assert.match(C.evaluate('review',s).message,/never approves/);}});
+test('malformed output collection never establishes evidence',()=>{for(const outputs of [null,[null],['a']]){const s=run();s.job.outputs=outputs;assert.equal(state('output',s),'unknown');}});
+test('target is resolved on each call and supports visible fallback',()=>{let current=null;const n={getClientRects:()=>[{}],closest:()=>null};const doc={getElementById:id=>id==='late'?current:id==='fallback'?n:null};assert.equal(C.visibleTarget({target:'#late'},doc),null);current=n;assert.equal(C.visibleTarget({target:'#late'},doc),n);current=null;assert.equal(C.visibleTarget({target:'#late',alternatives:['#fallback']},doc),n);assert.equal(C.visibleTarget({target:'[onclick]'},doc),null);});
+test('hidden and visibility-hidden targets remain untouched',()=>{const node={getClientRects:()=>[{}],closest:()=>null};const doc={getElementById:()=>node,defaultView:{getComputedStyle:()=>({visibility:'hidden'})}};assert.equal(C.visibleTarget({target:'#hidden'},doc),null);});
+test('routes cannot redirect outside the authored tools',()=>{const origin='http://127.0.0.1:8191';for(const value of ['https://untrusted.invalid/','javascript:alert(1)','/api/jobs','/?execute=true','http://user@127.0.0.1:8191/'])assert.throws(()=>C.route(value,origin));assert.equal(C.route('/workflow-studio.html#agents',origin).hash,'#agents');});
