{
  "schema_version": 1,
  "units": "metres; Blender Z-up (x right, y back, z up); assets stand on z=0",
  "generators": {
    "room_kit": {
      "description": "Anime-style open-front bedroom diorama: floor, three walls with a window, desk with lamp, bed, bookshelf, rug.",
      "tri_budget": 20000,
      "params": {
        "width": {"type": "float", "min": 2.4, "max": 6.0, "default": 3.6, "doc": "interior width (x)"},
        "depth": {"type": "float", "min": 2.4, "max": 6.0, "default": 3.4, "doc": "interior depth (y), open front at y=0"},
        "height": {"type": "float", "min": 2.2, "max": 3.2, "default": 2.5, "doc": "wall height"},
        "wall_thickness": {"type": "float", "min": 0.08, "max": 0.25, "default": 0.12},
        "window_width": {"type": "float", "min": 0.5, "max": 2.4, "default": 1.2},
        "window_height": {"type": "float", "min": 0.5, "max": 1.6, "default": 1.0},
        "window_sill": {"type": "float", "min": 0.4, "max": 1.2, "default": 0.9, "doc": "sill height above the floor top"},
        "window_offset": {"type": "float", "min": -2.0, "max": 2.0, "default": 0.0, "doc": "window centre x (negative = left seen from the open front)"},
        "desk_width": {"type": "float", "min": 0.6, "max": 1.8, "default": 1.1, "doc": "desk against the back wall from x = -width/2 + 0.05; must not reach the bed"},
        "desk_depth": {"type": "float", "min": 0.45, "max": 0.8, "default": 0.6},
        "bed_width": {"type": "float", "min": 0.8, "max": 1.8, "default": 1.0, "doc": "bed frame width against the right wall (x up to width/2 - 0.02), head at the back; mattress is 0.06 narrower"},
        "bed_length": {"type": "float", "min": 1.8, "max": 2.3, "default": 2.0, "doc": "must fit depth - 0.02"},
        "shelf_count": {"type": "int", "min": 2, "max": 6, "default": 4, "doc": "bookshelf levels on the left wall, in front of the desk"},
        "rug_radius": {"type": "float", "min": 0.4, "max": 1.5, "default": 0.9, "doc": "round rug centred at (0, 0.45 * depth); must stay inside the floor"},
        "detail": {"type": "int", "min": 4, "max": 48, "default": 16, "doc": "segments of round parts; LODs halve it"},
        "seed": {"type": "int", "min": 0, "max": 9999, "default": 7},
        "palette": {"type": "int", "min": 0, "max": 3, "default": 0, "gn": false, "doc": "flat toon palette: 0 day, 1 dusk, 2 sakura, 3 autumn"}
      },
      "constraints": [
        {"terms": {"window_offset": 1, "window_width": 0.5, "width": -0.5}, "le": -0.2, "doc": "window clears the right wall by 0.2 m"},
        {"terms": {"window_offset": -1, "window_width": 0.5, "width": -0.5}, "le": -0.2, "doc": "window clears the left wall by 0.2 m"},
        {"terms": {"window_sill": 1, "window_height": 1, "height": -1}, "le": -0.25, "doc": "window top stays 0.25 m below the wall top"}
      ],
      "parts": {
        "1": {"name": "floor", "group": "structure"},
        "2": {"name": "wall_back", "group": "structure"},
        "3": {"name": "wall_left", "group": "structure"},
        "4": {"name": "wall_right", "group": "structure"},
        "5": {"name": "window_frame", "group": "structure"},
        "6": {"name": "window_glass", "group": "structure", "open": true, "collision": false, "solid": false},
        "7": {"name": "desk", "group": "desk"},
        "8": {"name": "desk_lamp", "group": "desk", "collision": false},
        "9": {"name": "bed_frame", "group": "bed"},
        "10": {"name": "mattress", "group": "bed"},
        "11": {"name": "blanket", "group": "bed", "collision": false},
        "12": {"name": "pillow", "group": "bed", "collision": false},
        "13": {"name": "shelf", "group": "shelf"},
        "14": {"name": "books", "group": "shelf", "collision": false},
        "15": {"name": "rug", "group": "rug", "collision": false, "solid": false}
      }
    },
    "prop": {
      "description": "Stylised prop family selected by kind: 0 paper lantern (chochin), 1 wooden crate, 2 potted plant.",
      "tri_budget": 4000,
      "params": {
        "kind": {"type": "int", "min": 0, "max": 2, "default": 0, "doc": "0 lantern, 1 crate, 2 plant"},
        "height": {"type": "float", "min": 0.2, "max": 1.6, "default": 0.6},
        "width": {"type": "float", "min": 0.15, "max": 1.0, "default": 0.4},
        "detail": {"type": "int", "min": 4, "max": 48, "default": 16},
        "seed": {"type": "int", "min": 0, "max": 9999, "default": 7},
        "palette": {"type": "int", "min": 0, "max": 3, "default": 0, "gn": false, "doc": "flat toon palette: 0 day, 1 dusk, 2 sakura, 3 autumn"}
      },
      "constraints": [],
      "parts": {
        "1": {"name": "lantern_body", "group": "prop", "when": {"kind": [0, 0]}},
        "2": {"name": "lantern_caps", "group": "prop", "when": {"kind": [0, 0]}},
        "3": {"name": "lantern_hanger", "group": "prop", "when": {"kind": [0, 0]}, "collision": false},
        "4": {"name": "crate_core", "group": "prop", "when": {"kind": [1, 1]}},
        "5": {"name": "crate_frame", "group": "prop", "when": {"kind": [1, 1]}},
        "6": {"name": "pot", "group": "prop", "when": {"kind": [2, 2]}, "anchor": true},
        "7": {"name": "soil", "group": "prop", "when": {"kind": [2, 2]}, "collision": false},
        "8": {"name": "foliage", "group": "prop", "when": {"kind": [2, 2]}}
      }
    },
    "shrine": {
      "description": "Modular shrine set piece on a 0.5 m grid: steps, platform, torii gate, optional pair of stone lanterns.",
      "tri_budget": 12000,
      "params": {
        "gate_width": {"type": "float", "min": 1.6, "max": 5.0, "default": 2.6, "doc": "pillar centre spacing"},
        "gate_height": {"type": "float", "min": 2.2, "max": 5.5, "default": 3.4},
        "pillar_radius": {"type": "float", "min": 0.08, "max": 0.3, "default": 0.15},
        "step_count": {"type": "int", "min": 0, "max": 8, "default": 3},
        "step_rise": {"type": "float", "min": 0.1, "max": 0.22, "default": 0.16},
        "step_run": {"type": "float", "min": 0.25, "max": 0.45, "default": 0.32},
        "lanterns": {"type": "int", "min": 0, "max": 1, "default": 1, "doc": "1 adds a stone lantern pair"},
        "detail": {"type": "int", "min": 4, "max": 48, "default": 16},
        "palette": {"type": "int", "min": 0, "max": 3, "default": 0, "gn": false, "doc": "flat toon palette: 0 day, 1 dusk, 2 sakura, 3 autumn"}
      },
      "constraints": [],
      "parts": {
        "1": {"name": "platform", "group": "ground"},
        "2": {"name": "steps", "group": "ground", "when": {"step_count": [1, 8]}},
        "3": {"name": "torii_pillars", "group": "torii"},
        "4": {"name": "torii_beams", "group": "torii"},
        "5": {"name": "pillar_bases", "group": "torii"},
        "6": {"name": "stone_lanterns", "group": "lanterns", "when": {"lanterns": [1, 1]}}
      }
    },
    "lighthouse_room": {
      "description": "Round lighthouse map room (Suzu's story): ring wall of radial panels with windows, spiral steps on the wall, central map table with a chart, a stool and the room-kit bookshelf of charts. cutaway=1 opens the front for diorama cameras.",
      "tri_budget": 20000,
      "params": {
        "radius": {"type": "float", "min": 1.8, "max": 4.0, "default": 2.5, "doc": "interior radius"},
        "wall_thickness": {"type": "float", "min": 0.15, "max": 0.4, "default": 0.25},
        "height": {"type": "float", "min": 2.4, "max": 4.0, "default": 3.0, "doc": "wall height"},
        "panels": {"type": "int", "min": 12, "max": 32, "default": 20, "doc": "radial wall panels around the ring"},
        "window_every": {"type": "int", "min": 2, "max": 6, "default": 3, "doc": "every Nth panel is a window; panel 0 faces the front (-y)"},
        "window_sill": {"type": "float", "min": 0.5, "max": 1.2, "default": 0.9},
        "window_height": {"type": "float", "min": 0.5, "max": 1.4, "default": 1.1},
        "table_radius": {"type": "float", "min": 0.4, "max": 1.2, "default": 0.7, "doc": "central map table"},
        "stair_steps": {"type": "int", "min": 0, "max": 10, "default": 8, "doc": "spiral steps on the left wall, centred 0.4 m from it"},
        "shelf_count": {"type": "int", "min": 2, "max": 5, "default": 4, "doc": "chart shelf levels at the back"},
        "cutaway": {"type": "int", "min": 0, "max": 1, "default": 1, "doc": "1 removes the five front panels"},
        "detail": {"type": "int", "min": 4, "max": 48, "default": 24},
        "seed": {"type": "int", "min": 0, "max": 9999, "default": 7},
        "palette": {"type": "int", "min": 0, "max": 3, "default": 0, "gn": false, "doc": "flat toon palette: 0 day, 1 dusk, 2 sakura, 3 autumn"}
      },
      "constraints": [
        {"terms": {"window_sill": 1, "window_height": 1, "height": -1}, "le": -0.3, "doc": "window top stays 0.3 m below the wall top"},
        {"terms": {"table_radius": 1, "radius": -1}, "le": -1.1, "doc": "map table clears the spiral steps"},
        {"terms": {"shelf_count": 0.35, "height": -1}, "le": -0.3, "doc": "chart shelf fits under the wall top"}
      ],
      "parts": {
        "1": {"name": "floor", "group": "structure", "anchor": true},
        "2": {"name": "wall", "group": "structure"},
        "3": {"name": "spiral_steps", "group": "structure", "when": {"stair_steps": [1, 10]}},
        "4": {"name": "map_table", "group": "table"},
        "5": {"name": "chart", "group": "table", "collision": false},
        "6": {"name": "stool", "group": "table"},
        "7": {"name": "chart_shelf", "group": "shelf"},
        "8": {"name": "rug", "group": "rug", "collision": false, "solid": false},
        "9": {"name": "window_glass", "group": "structure", "collision": false},
        "10": {"name": "charts", "group": "shelf", "collision": false}
      }
    }
  }
}
